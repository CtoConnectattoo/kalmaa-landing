---
// Comentario «CITA» → DM de Kalmaa con botón a WhatsApp. Sin logos de terceros.
---

<figure class="wa" aria-label="Ejemplo: un comentario CITA recibe un DM con botón a WhatsApp">
  <div class="wa__comment">
    <span class="wa__avatar" aria-hidden="true">L</span>
    <p><strong>laura.m</strong> CITA</p>
  </div>
  <div class="wa__arrow" aria-hidden="true">↓</div>
  <div class="wa__dm">
    <p class="wa__label">Mensaje directo</p>
    <p class="wa__bubble">¡Hola, Laura! Escríbeme por WhatsApp y te doy cita esta semana.</p>
    <span class="wa__btn">Abrir WhatsApp</span>
  </div>
</figure>

<style>
  .wa {
    margin: 0;
    display: grid;
    gap: 14px;
    max-width: 420px;
    width: 100%;
  }
  .wa__comment {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--k-graphite);
    border: 1px solid var(--k-graphite-2);
    border-radius: 20px;
    padding: 14px 18px;
  }
  .wa__comment strong {
    color: var(--k-white);
    margin-right: 6px;
  }
  .wa__comment p {
    color: var(--k-body-dark);
  }
  .wa__avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--k-graphite-2);
    font-weight: 600;
  }
  .wa__arrow {
    justify-self: center;
    color: var(--k-lime);
    font-size: 22px;
  }
  .wa__dm {
    background: var(--k-graphite);
    border: 1px solid var(--k-graphite-2);
    border-radius: 24px;
    padding: 18px;
    display: grid;
    gap: 12px;
  }
  .wa__label {
    font-size: 13px;
    color: var(--k-muted);
  }
  .wa__bubble {
    background: var(--k-lime);
    color: var(--k-black);
    border-radius: 18px;
    border-bottom-left-radius: 6px;
    padding: 12px 16px;
    font-weight: 500;
  }
  .wa__btn {
    justify-self: start;
    background: var(--k-pink);
    color: var(--k-black);
    font-weight: 600;
    border-radius: 12px;
    padding: 10px 16px;
  }
</style>
