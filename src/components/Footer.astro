---
import Logo from './Logo.astro';
import { FOOTER, SITE } from '../data/site';
const year = 2026;
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo />
        <p>{SITE.entity}.</p>
      </div>
      <nav class="footer__cols" aria-label="Pie de página">
        <div>
          <p class="footer__title">Producto</p>
          <ul>{FOOTER.producto.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
        <div>
          <p class="footer__title">Guías</p>
          <ul>{FOOTER.guias.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
        <div>
          <p class="footer__title">Comparativas</p>
          <ul>{FOOTER.comparativas.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
      </nav>
    </div>
    <div class="footer__bottom">
      <p>
        © {year} {SITE.company} · ChatGPT es una marca de OpenAI; Claude, de Anthropic; Instagram y WhatsApp,
        de Meta. Kalmaa no está afiliada a ellas.
      </p>
      <ul class="footer__legal">
        {FOOTER.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--k-graphite-2);
    padding: 64px 0 40px;
    color: var(--k-muted);
    font-size: 15px;
  }
  .footer__top {
    display: grid;
    gap: 40px;
  }
  .footer__brand {
    display: grid;
    gap: 14px;
    max-width: 320px;
  }
  .footer__cols {
    display: grid;
    gap: 28px;
  }
  .footer__title {
    color: var(--k-white);
    font-weight: 600;
    margin-bottom: 12px;
  }
  .footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .footer a {
    color: var(--k-muted);
    text-decoration: none;
  }
  .footer a:hover {
    color: var(--k-white);
  }
  .footer__bottom {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--k-graphite-2);
    display: grid;
    gap: 16px;
    font-size: 14px;
  }
  .footer__legal {
    display: flex !important;
    flex-wrap: wrap;
    gap: 20px !important;
  }
  @media (min-width: 860px) {
    .footer__top {
      grid-template-columns: 1fr 2.2fr;
    }
    .footer__cols {
      grid-template-columns: repeat(3, 1fr);
    }
    .footer__bottom {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
